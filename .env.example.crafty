# curseforge-server-updater - Crafty Controller Configuration
# For servers managed by Crafty Controller (https://craftycontrol.com)
# Copy this file to .env and fill in your values.

# CurseForge
CF_API_KEY=your_curseforge_api_key_here
CF_PROJECT_ID=1518930
CF_GAME_VERSION=1.21.1

# Server
# If using Docker: this is the bind-mounted path on the host
SERVER_DIR=/srv/crafty/servers/my-server
PRESERVE_ITEMS=world,server.properties,whitelist.json,ops.json,banned-players.json,banned-ips.json,eula.txt,server.jar,user_jvm_args.txt,crafty_launcher.sh
SERVER_USER=

# Server Manager
SERVER_MANAGER=crafty
STOP_WAIT_SECONDS=15

# Crafty Controller
CRAFTY_URL=https://127.0.0.1:8443
CRAFTY_USER=admin
CRAFTY_PASS=your_crafty_admin_password
# Find the UUID in Crafty UI or in the database
CRAFTY_SERVER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Backup
RUN_BACKUP_BEFORE=true
BACKUP_SCRIPT=/srv/crafty/backup-complet.sh
BACKUP_DIR=/srv/crafty/backups

# variables.txt patches (ServerStarterJar packs)
# These are re-applied after each update to keep your custom settings.
VARS_PATCHES=SKIP_JAVA_CHECK=true
JAVA="/usr/bin/java"
SERVERSTARTERJAR_FORCE_FETCH=false
WAIT_FOR_USER_INPUT=false
RESTART=false

# Logging
LOG_FILE=/srv/crafty/logs/update-modpack.log

# Notifications
DISCORD_WEBHOOK=
