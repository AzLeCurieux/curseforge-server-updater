# curseforge-server-updater - General Configuration
# Copy this file to .env and fill in your values.

# CurseForge
# Get your API key at: https://console.curseforge.com -> API Keys
CF_API_KEY=your_curseforge_api_key_here
CF_PROJECT_ID=1518930
CF_GAME_VERSION=1.21.1

# Server
SERVER_DIR=/opt/minecraft/server
PRESERVE_ITEMS=world,server.properties,whitelist.json,ops.json,banned-players.json,banned-ips.json,eula.txt,server.jar,user_jvm_args.txt
SERVER_USER=minecraft

# Server Manager
# Options: crafty | systemd | screen | tmux | none
SERVER_MANAGER=systemd
STOP_WAIT_SECONDS=15

# systemd
SYSTEMD_SERVICE=minecraft

# screen
SCREEN_SESSION=minecraft

# tmux
TMUX_SESSION=minecraft

# Backup
RUN_BACKUP_BEFORE=true
BACKUP_DIR=/opt/minecraft/backups
BACKUP_SCRIPT=

# variables.txt patches (ServerStarterJar packs)
# Key=value pairs re-applied after each update. One per line.
VARS_PATCHES=

# Logging
LOG_FILE=/var/log/mc-updater/update-modpack.log

# Notifications
DISCORD_WEBHOOK=
